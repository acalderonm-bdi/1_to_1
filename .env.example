# ========================================
# SUPABASE (OBLIGATORIO)
# Obtén estos valores en: Supabase > Project Settings > API
# ========================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=mlmpjeneeckfdyqavwgj
SUPABASE_DB_PASSWORD=

# ========================================
# ADMIN INICIAL (OBLIGATORIO)
# El sistema creará este usuario con rol Arquitectura Humana
# Si dejas ADMIN_PASSWORD vacío, se genera automáticamente
# ========================================
ADMIN_EMAIL=admin@empresa.com
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Administrador del Sistema

# ========================================
# GOOGLE OAUTH (OBLIGATORIO para SSO + Calendar + Meet)
# Obtén estos en: console.cloud.google.com > APIs & Services > Credentials
# ========================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback

# ========================================
# ANTHROPIC CLAUDE (OBLIGATORIO)
# Obtén tu API key en: console.anthropic.com
# ========================================
ANTHROPIC_API_KEY=

# ========================================
# SLACK (OPCIONAL - el sistema funciona sin esto)
# Crea un bot en: api.slack.com/apps
# ========================================
SLACK_BOT_TOKEN=
SLACK_DEFAULT_CHANNEL=

# ========================================
# RESEND EMAIL (OPCIONAL - el sistema funciona sin esto)
# Obtén tu API key en: resend.com
# ========================================
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ========================================
# APP
# ========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=cambiar-en-produccion-rotar-mensualmente

# ========================================
# SEED (true = crea datos de ejemplo al inicializar)
# ========================================
SEED_DEMO_DATA=true
